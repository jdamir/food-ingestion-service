# 1. Бинарники и скомпилированные файлы Go
# (бинарные файлы весят много и собираются под каждую ОС индивидуально)
*-bin
*.exe
*.exe~
*.dll
*.so
*.dylib
app-bin

# 2. Локальные переменные окружения и секреты
# (Файлы с паролями от БД и JWT-ключами строго запрещено пушить в паблик)
.env
*.env
.env.local

# 3. Данные баз данных и кэша
# (Если вы монтируете папки данных Postgres/Redis локально)
pgdata/
redisdata/
s3data/
chdata/
.data/

# 4. Логи и временные файлы разработки
*.log
.idea/
.vscode/
*.bench
*.out
*.prof
